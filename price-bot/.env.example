# Токен бота от @BotFather
BOT_TOKEN=
# Ваш Telegram ID (узнать у @userinfobot). Несколько — через запятую
ADMIN_IDS=996644902

SHOP_NAME=AVIOR
WELCOME_TEXT=Оригинальная техника Apple и не только.\nАктуальные цены, гарантия. Доставка курьером по Москве, СДЭК и Ozon.\n\n🕚 Цены обновляются каждый день с 11:00 до 12:00 (МСК).
CONTACTS_TEXT=📍 Москва, Можайское шоссе, 4к1\n📞 +7 (901) 222-81-11\n🌐 Сайт: avior.moscow\n\n🚚 Доставка:\n• курьером по Москве\n• СДЭК\n• Ozon доставка

# Способы получения заказа (через запятую)
DELIVERY_OPTIONS=🚚 Курьер по Москве,📦 СДЭК,📦 Ozon доставка,🏬 Самовывоз (Можайское ш. 4к1)

# Наценка по умолчанию (потом меняется командами /markup и /round прямо в боте)
# Телефоны, ноутбуки, Mac, планшеты и всё остальное: +10 000 ₽
MARKUP_PCT=0
MARKUP_FIXED=10000
ROUND_STEP=100

# Аксессуары (категории, в названии которых есть эти слова): +5 000 ₽
ACCESSORY_MARKUP=5000
ACCESSORY_WORDS=airpods,наушник,очки,ray-ban,рейбан,часы,watch,aw ,колонк,гаджет,аксессуар

# Позиции с этими словами не продаём (начальный список; потом меняется командой /exclude в боте)
EXCLUDE_WORDS=чехол,silicone case,clear case,leather case,techwoven,finewoven,case with magsafe,adapter,адаптер,зарядк,charger,кабель,cable,гарант,🛡,стекло,пленк,плёнк,ремеш,гравировк,установка,блок 

# Категории поставщика (как на кнопках меню), которые не загружаем; потом меняется командой /skipcat
SKIP_CATEGORIES=Телевизоры,Быт.Техника
# Категории поставщика, которые объединяем в одну нашу (источник=куда, через запятую); команда /mergecat
MERGE_CATEGORIES=Игровые Ноутбуки=Ноутбуки,Пылесосы=Dyson
# Из этих категорий поставщика берём только позиции с указанным словом; команда /onlycat
ONLY_WORDS=Пылесосы=dyson

# Строки прайса с этими словами не попадут в бот (через запятую, без учёта регистра)
BLOCK_WORDS=bigsale
DB_PATH=data/shop.db

# CRM сервиса: заявки на ремонт из бота попадают туда же, куда заявки с сайта.
# Секрет — тот же, что crm_lead_secret в config.php сайта (CRM → Настройки → «Приём заявок с сайта»)
CRM_LEAD_SECRET=
# CRM_API_URL=https://cms.avior.moscow/api

# Дополнительный красивый адрес бота (Telegram Premium, например avior_app): /links покажет ссылки через него.
# QR-коды для печати всё равно ведут на основной адрес — он не зависит от подписки.
# LINK_USERNAME=avior_app

# Бот в мессенджере MAX (отдельная служба avior-max, база общая с Telegram-ботом).
# Токен — в кабинете business.max.ru после создания бота. Проверка: python manage.py max-check
MAX_TOKEN=
# MAX_API_URL=https://platform-api2.max.ru
# Если сервер не доверяет сертификату API MAX — путь к сертификату НУЦ Минцифры:
# MAX_CA_FILE=/opt/avior/russian_trusted_root_ca.pem

# Бот в WhatsApp (служба avior-wa, Cloud API Meta; нужен https-адрес — см. Caddyfile.example)
# WA_TOKEN — постоянный токен системного пользователя (business.facebook.com → Пользователи системы)
WA_TOKEN=
# WA_PHONE_ID — Phone number ID (developers.facebook.com → приложение → WhatsApp → API Setup)
WA_PHONE_ID=
# WA_VERIFY_TOKEN — любое придуманное слово; то же вписать в Meta при подключении webhook
WA_VERIFY_TOKEN=
# WA_APP_SECRET — App secret (Настройки приложения → Основное): проверка, что запросы от Meta
WA_APP_SECRET=
# WA_API_VERSION=v24.0
# WA_PORT=8081
