# Токен бота от @BotFather
BOT_TOKEN=
# Ваш Telegram ID (узнать у @userinfobot). Несколько — через запятую
ADMIN_IDS=996644902

SHOP_NAME=AVIOR Shop
WELCOME_TEXT=Оригинальная техника Apple и не только.\nАктуальные цены, гарантия. Доставка курьером по Москве, СДЭК и Ozon.
CONTACTS_TEXT=📍 Москва, Можайское шоссе, 4к1\n📞 +7 (901) 222-81-11\n💬 Telegram: @ghost0590\n\n🚚 Доставка:\n• курьером по Москве\n• СДЭК\n• Ozon доставка

# Способы получения заказа (через запятую)
DELIVERY_OPTIONS=🚚 Курьер по Москве,📦 СДЭК,📦 Ozon доставка,🏬 Самовывоз (Можайское ш. 4к1)

# Наценка по умолчанию (потом меняется командами /markup и /round прямо в боте)
# Телефоны, ноутбуки, Mac, планшеты и всё остальное: +10 000 ₽
MARKUP_PCT=0
MARKUP_FIXED=10000
ROUND_STEP=100

# Аксессуары (категории, в названии которых есть эти слова): +5 000 ₽
ACCESSORY_MARKUP=5000
ACCESSORY_WORDS=airpods,наушник,очки,ray-ban,рейбан,часы,watch,aw ,колонк,гаджет,аксессуар

# Позиции с этими словами не продаём (начальный список; потом меняется командой /exclude в боте)
EXCLUDE_WORDS=чехол,silicone case,clear case,leather case,techwoven,finewoven,case with magsafe,adapter,адаптер,зарядк,charger,кабель,cable,гарант,🛡,стекло,пленк,плёнк,ремеш,гравировк,установка,блок 

# Категории поставщика (как на кнопках меню), которые не загружаем; потом меняется командой /skipcat
SKIP_CATEGORIES=Телевизоры,Быт.Техника
# Категории поставщика, которые объединяем в одну нашу (источник=куда, через запятую); команда /mergecat
MERGE_CATEGORIES=Игровые Ноутбуки=Ноутбуки,Пылесосы=Dyson
# Из этих категорий поставщика берём только позиции с указанным словом; команда /onlycat
ONLY_WORDS=Пылесосы=dyson

# Строки прайса с этими словами не попадут в бот (через запятую, без учёта регистра)
BLOCK_WORDS=bigsale
DB_PATH=data/shop.db
